  "concepts": [
    {"id":"home","label":"Home","category":"convention-dominant","meaning":"Navigate to the primary home or start surface.","mustCommunicate":["home","primary destination"],"mustNotMean":["building category","real estate"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["dashboard"]},
    {"id":"menu","label":"Menu","category":"convention-dominant","meaning":"Open or reveal a navigation menu.","mustCommunicate":["menu","navigation"],"mustNotMean":["list formatting","drag handle"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["filter"]},
    {"id":"search","label":"Search","category":"convention-dominant","meaning":"Search or find content.","mustCommunicate":["search","find"],"mustNotMean":["zoom only","inspect"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["zoom","link"]},
    {"id":"edit","label":"Edit","category":"convention-dominant","meaning":"Edit or modify existing content.","mustCommunicate":["edit","modify"],"mustNotMean":["write new only","link"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["link"]},
    {"id":"like","label":"Like","category":"neighbor-sensitive","meaning":"Express positive reaction or appreciation.","mustCommunicate":["like","positive reaction"],"mustNotMean":["favorite","save"],"conventionStrength":"high","allowedOriginality":"medium","collisionRisks":["favorite"]},
    {"id":"favorite","label":"Favorite","category":"neighbor-sensitive","meaning":"Mark something as a favorite for preference or later recall.","mustCommunicate":["favorite","preference"],"mustNotMean":["like only","bookmark save"],"conventionStrength":"high","allowedOriginality":"medium","collisionRisks":["like","bookmark"]},
    {"id":"bookmark","label":"Bookmark","category":"convention-dominant","meaning":"Save or bookmark an item for later access.","mustCommunicate":["bookmark","save for later"],"mustNotMean":["favorite preference","download"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["favorite"]},
    {"id":"share","label":"Share","category":"neighbor-sensitive","meaning":"Share the current object outside its present context.","mustCommunicate":["share","send outward"],"mustNotMean":["upload","log out","external link only"],"conventionStrength":"high","allowedOriginality":"medium","collisionRisks":["upload","logout","link"]},
    {"id":"download","label":"Download","category":"neighbor-sensitive","meaning":"Receive or save a resource from the system to a local destination.","mustCommunicate":["download","receive"],"mustNotMean":["upload","move down"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["upload"]},
