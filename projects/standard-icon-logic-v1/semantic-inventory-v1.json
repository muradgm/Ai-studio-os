    {"id":"filter","label":"Filter","category":"convention-dominant","meaning":"Narrow visible content using criteria.","mustCommunicate":["filter","narrow results"],"mustNotMean":["menu","sort only"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["menu"]},
    {"id":"link","label":"Link","category":"convention-dominant","meaning":"Create, attach or represent a hyperlink or connection.","mustCommunicate":["link","connection"],"mustNotMean":["share","edit"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["share","edit"]},
