    {"id":"lock","label":"Lock","category":"convention-dominant","meaning":"Indicate locked, protected or secure access.","mustCommunicate":["locked","secure"],"mustNotMean":["privacy mode only","archive"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["security"]},
    {"id":"upload","label":"Upload","category":"neighbor-sensitive","meaning":"Send a resource from the current device or context into the system.","mustCommunicate":["upload","send into system"],"mustNotMean":["share","download","log out"],"conventionStrength":"very-high","allowedOriginality":"low","collisionRisks":["share","download"]},
