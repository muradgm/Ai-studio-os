      "advisory judgment and consequential action occupy different authority domains",
      "transition between those domains requires explicit human authority",
      "the authority boundary carries consequence"
    ],
    "mustNotMean": [
      "security or authentication",
      "navigation or forward action",
      "split pane, alignment, docking or resize",
      "generic success or completion",
      "a transient approval or execution status"
    ],
    "mustNotEncode": [
      "approval-required",
      "authorized",
      "withheld",
      "granted",
      "executing",
      "execution-state"
    ],
    "contexts": [
      "approval request",
      "decision authority",
      "external mutation",
      "destructive or high-risk action"
    ]
  },
  "familiarityDecision": {
    "mode": "brand-original-required",
    "rationale": "No single established UI glyph expresses the stable boundary between advisory intelligence and consequential human authority without collapsing into security, navigation, completion or transient approval-state semantics."
  },
