{
  "name": "ai-studio-os",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "A modular operating system for AI-assisted product, creative, engineering, multimodal, observation, creative-production, identity, brand-kit, and creative-engineering work.",
  "scripts": {
    "dev": "node ./scripts/dev-creative-agency.mjs",
    "dev:web": "vite apps/creative-agency --host 0.0.0.0",
    "dev:execution": "node apps/creative-agency/execution-server.mjs",
    "build:web": "vite build apps/creative-agency --outDir ../../dist/creative-agency --emptyOutDir",
    "preview:web": "vite preview apps/creative-agency --host 0.0.0.0",
    "build:creative-engineering": "vite build apps/creative-engineering-fixture --outDir ../../dist/creative-engineering-fixture --emptyOutDir",
    "test:browser-runtime": "node ./scripts/creative-engineering-browser-smoke.mjs",
    "test:command-center": "node ./scripts/command-center-execution-smoke.mjs",
    "test:typography-browser": "node ./scripts/typography-browser-proof.mjs",
    "proof:ai-council": "node ./scripts/ai-council-style-frame-proof.mjs && node ./scripts/finalize-ai-council-style-frame-proof.mjs",
    "proof:ai-council-ux": "node ./scripts/ai-council-ux-wireframe-proof.mjs && node ./scripts/finalize-ai-council-ux-wireframe-proof.mjs",
    "proof:ai-council-worlds": "node ./scripts/ai-council-canonical-ux-world-proof.mjs",
    "proof:ai-council-hybrid": "node ./scripts/ai-council-hybrid-v1-proof.mjs",
    "fonts:sync": "node ./scripts/sync-google-fonts.mjs",
    "fonts:analyze": "node ./scripts/analyze-google-fonts.mjs",
    "studio": "node ./bin/studio.mjs",
    "validate": "node ./scripts/validate.mjs",
    "benchmark": "node ./bin/studio.mjs benchmark du-bonheur && node ./bin/studio.mjs benchmark workspace-role-update && node ./bin/studio.mjs benchmark du-bonheur-brand-film && node ./bin/studio.mjs benchmark du-bonheur-post-launch && node ./bin/studio.mjs benchmark du-bonheur-v11 && node ./bin/studio.mjs benchmark identity-v12 && node ./bin/studio.mjs benchmark creative-engineering-v13 && node ./bin/studio.mjs benchmark brand-identity-kit-v1 && node ./bin/studio.mjs benchmark typography-intelligence-v01 && node ./bin/studio.mjs benchmark award-caliber-web-v1",
    "logo:integrity": "node ./bin/logo-integrity.mjs",
    "test:logo-integrity": "node --test integration/logo-artifact-integrity.mjs integration/logo-artifact-runtime.mjs",
    "test": "node --test && npm run validate"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.39.1",
    "gsap": "^3.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^7.1.0"
  },
  "engines": {"node": ">=20"}
}
