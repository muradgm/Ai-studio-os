  "assetType": "icon",
  "conceptId": "authority",
  "semanticIntent": {
    "meaning": "Boundary between advisory judgment and consequential action whose transition requires explicit human authority.",
    "mustCommunicate": [
      "advisory judgment and consequential action occupy different authority domains",
      "transition between those domains requires explicit human authority",
      "the authority boundary carries consequence"
    ],
    "mustNotMean": [
      "security or authentication",
      "navigation or forward action",
      "split pane, alignment, docking or resize",
      "generic success or completion",
      "a transient approval or execution status"
    ],
    "mustNotEncode": ["approval-required", "authorized", "withheld", "granted", "executing", "execution-state"],
    "contexts": ["approval request", "decision authority", "external mutation", "destructive or high-risk action"]
  },
  "familiarityDecision": {
    "mode": "brand-original-required",
    "rationale": "Authority needs an original but restrained boundary metaphor because familiar security, navigation and split-pane symbols carry stronger learned meanings than the intended AI Council concept."
  },
  "targetSizes": [14, 16, 24],
  "sizeBudgets": {
    "14": {"maxSemanticDevices": 1},
    "16": {"maxSemanticDevices": 2},
    "24": {"maxSemanticDevices": 3}
  },
